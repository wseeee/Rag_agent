# ==========================================
# 敏感凭据与配置文件 (包含真实 API Key / 数据库密码)
# ==========================================
config.yaml
**/config/config.yaml
**/config/*.yaml
!**/*.example.yaml
!**/*.example.yml
*.env
*.env.*
!*.env.example

# 证书与私钥
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secret.yaml
secrets.yaml

# ==========================================
# 本地运行数据、日志与临时文件
# ==========================================
*.log
logs/
**/logs/
*.tmp
etc/docker/volumes/
**/volumes/
etc/output/
output/
temp/
temp.yaml

# 知识库与文档目录（完全忽略）
docs/
**/docs/

# ==========================================
# 本地工具与索引库
# ==========================================
.codegraph/

# ==========================================
# 编译产物与可执行文件
# ==========================================
bin/
bin
main
main.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
gf

# ==========================================
# IDE 与编辑器文件
# ==========================================
.idea/
.vscode/
.settings/
.project
.buildpath
*.swp
*.swo
*.orig
*~
.hgignore.swp

# ==========================================
# 系统文件
# ==========================================
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# ==========================================
# 前端依赖与产物 (Frontend)
# ==========================================
Frontend/node_modules/
Frontend/dist/
Frontend/.cache/
