# https://goframe.org/docs/web/server-config-file-template
server:
  address: ":6872"
  openapiPath: "/api.json"
  swaggerPath: "/swagger"

# https://goframe.org/docs/core/glog-config
logger:
  level: "all"
  stdout: true

ds_think_chat_model:
  api_key: "your-dashscope-api-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "deepseek-v4.1-flash"

ds_quick_chat_model:
  api_key: "your-dashscope-api-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "deepseek-v4.1-flash"

# 豆包embedding下架，下面的api key和base url换成阿里云的
doubao_embedding_model:
  api_key: "your-dashscope-api-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "qwen3.7-text-embedding"

file_dir: "./docs"

# 腾讯云托管MCP下架，使用本地部署方案
mcp_url: "http://localhost:3000/sse"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

minio:
  endpoint: "127.0.0.1:9000"
  accessKey: "minioadmin"
  secretKey: "minioadmin"
  useSSL: false
  bucket: "superbiz-documents"

kafka:
  brokers:
    - "127.0.0.1:9092"
  topic: "superbiz-file-processing"
  group_id: "superbiz-file-indexer-group"

# Apache Tika 文档抽取服务配置
tika:
  server_url: "http://127.0.0.1:9998"

# Milvus 向量数据库连接与集合配置
milvus:
  addr: "localhost:19530"
  default_db: "default"
  db_name: "agent"
  collection_name: "biz"

# 知识库双引擎检索与加权重排序配置
retriever:
  top_k: 8
  dense_weight: 0.7
  bm25_weight: 0.3

# MySQL 事实真理源配置
mysql:
  dsn: "root:password@tcp(127.0.0.1:3307)/superbiz_agent?charset=utf8mb4&parseTime=True&loc=Local"
  max_idle_conns: 10
  max_open_conns: 50

# 上下文工程三层记忆系统参数
memory:
  short_term_window: 10         # 最近保留对话轮次
  summary_trigger_turns: 10     # 触发增量摘要轮次
  ttl_days: 7                   # Redis 缓存保留天数
  long_term_threshold: 0.60     # Milvus 长期记忆 Cosine 相似度阈值
  top_k: 5                      # 长期记忆召回条数
  milvus_collection: "user_memory" # Milvus 长期记忆集合名

# Sentry 错误追踪与智能体诊断配置
sentry:
  dsn: "https://your-dsn@o0.ingest.sentry.io/0"
  auth_token: "your-sentry-auth-token"
  org: "your-sentry-org"
  project: "your-sentry-project"
  base_url: "https://sentry.io"
  traces_sample_rate: 1.0
