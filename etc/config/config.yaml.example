# https://goframe.org/docs/web/server-config-file-template
server:
  address: ":6872"
  openapiPath: "/api.json"
  swaggerPath: "/swagger"

# https://goframe.org/docs/core/glog-config
logger:
  level: "all"
  stdout: true

ds_think_chat_model:
  api_key: "your-dashscope-api-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "deepseek-v4.1-flash"

ds_quick_chat_model:
  api_key: "your-dashscope-api-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "deepseek-v4.1-flash"

# 豆包embedding下架，下面的api key和base url换成阿里云的
doubao_embedding_model:
  api_key: "your-dashscope-api-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "text-embedding-v4"

file_dir: "./docs"

# 腾讯云托管MCP下架，使用本地部署方案
mcp_url: "http://localhost:3000/sse"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

minio:
  endpoint: "127.0.0.1:9000"
  accessKey: "minioadmin"
  secretKey: "minioadmin"
  useSSL: false
  bucket: "superbiz-documents"

kafka:
  brokers:
    - "127.0.0.1:9092"
  topic: "superbiz-file-processing"
  group_id: "superbiz-file-indexer-group"

# Apache Tika 文档抽取服务配置
tika:
  server_url: "http://127.0.0.1:9998"

# Milvus 向量数据库连接与集合配置
milvus:
  addr: "localhost:19530"
  default_db: "default"
  db_name: "agent"
  collection_name: "biz"

# 知识库双引擎检索与加权重排序配置
retriever:
  top_k: 8
  dense_weight: 0.7
  bm25_weight: 0.3


